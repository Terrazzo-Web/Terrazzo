# Use the official multi-architecture Ubuntu 26.04 LTS image, including ARM64 support for the Gentoo VM.
FROM docker.io/library/ubuntu:26.04

# Give command-line tools and desktop sessions a consistent UTF-8 locale.
ENV LANG=C.UTF-8 \
    LC_ALL=C.UTF-8

RUN \
    # Write a Debian service-policy hook: exit 101 prevents package scripts from starting services during the build.
    printf '#!/bin/sh\nexit 101\n' > /usr/sbin/policy-rc.d \
    # Make the service-policy hook executable so package installation tools can invoke it.
    && chmod 755 /usr/sbin/policy-rc.d \
    # Refresh the Ubuntu package indexes before resolving package versions.
    && apt-get update \
    # Install the desktop, RDP services and runtime helpers without prompts or optional recommended packages.
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        # Provide compilers, Make and development headers for linking Rust projects.
        build-essential \
        ca-certificates \
        # Build native libraries used by Rust dependencies.
        cmake \
        # Download the official rustup installer and other HTTPS resources.
        curl \
        dbus \
        dbus-x11 \
        # Provide OpenSSL headers and libraries for Terrazzo's server build.
        libssl-dev \
        # Provide ifconfig and the other traditional network inspection tools.
        net-tools \
        # Provide outbound SSH, SCP and SFTP clients.
        openssh-client \
        openssl \
        passwd \
        # Let Rust build scripts locate native libraries such as OpenSSL.
        pkg-config \
        # Generate Rust bindings from Terrazzo's Protocol Buffer definitions.
        protobuf-compiler \
        # Provide Ubuntu's repository management utilities, including add-apt-repository.
        software-properties-common \
        sudo \
        tini \
        xfce4 \
        xfce4-terminal \
        xfonts-base \
        xorgxrdp \
        xrdp \
        # Unpack .xz archives, including downloaded development tools.
        xz-utils \
    # Remove downloaded package indexes to reduce the image layer size.
    && rm -rf /var/lib/apt/lists/* \
    # Create the non-root desktop login account with its own home directory and Bash shell.
    && useradd --create-home --shell /bin/bash richard \
    # Keep password login locked until the entrypoint applies the runtime password secret.
    && passwd --lock richard \
    # Allow the desktop user to run administrative commands without a sudo password.
    && install -d -m 755 /etc/sudoers.d \
    # Store the rule in sudo's included configuration directory.
    && printf 'richard ALL=(ALL:ALL) NOPASSWD: ALL\n' > /etc/sudoers.d/richard \
    # Restrict access to the sudo rule using the permissions required by sudo.
    && chmod 440 /etc/sudoers.d/richard \
    # Reject an invalid sudo configuration during the image build.
    && visudo -c \
    # Remove packaged certificate links; the entrypoint generates the container's RDP TLS identity.
    && rm -f /etc/xrdp/cert.pem /etc/xrdp/key.pem \
    # Start each RDP desktop in a fresh D-Bus session, clearing inherited session identifiers first.
    && printf '#!/bin/sh\nunset SESSION_MANAGER DBUS_SESSION_BUS_ADDRESS\nexec dbus-run-session -- startxfce4\n' \
        > /etc/xrdp/startwm.sh \
    # Allow xrdp-sesman to execute the desktop startup script.
    && chmod 755 /etc/xrdp/startwm.sh

RUN \
    # Remove Ubuntu's unused default login account to free UID/GID 1000 for the desktop user.
    userdel --remove ubuntu \
    # Match richard's Gentoo UID/GID so the host home bind mount stays writable by both accounts.
    && groupmod --gid 1000 richard \
    && usermod --uid 1000 --gid 1000 richard \
    # Align the image's initial home files with the desktop account's new numeric identity.
    && chown -R richard:richard /home/richard

# Keep the image's Rust installation outside the bind-mounted desktop home directory.
ENV CARGO_HOME=/opt/rust/cargo \
    RUSTUP_HOME=/opt/rust/rustup \
    PATH="/opt/rust/cargo/bin:${PATH}"

RUN \
    # Download rustup separately so a failed download fails the image build.
    curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs -o /tmp/rustup-init.sh \
    # Install stable Rust without prompts or changes to root's shell startup files.
    && sh /tmp/rustup-init.sh -y --profile minimal --default-toolchain stable --no-modify-path \
    # Install the language server used by editors for Rust completion and diagnostics.
    && rustup component add rust-analyzer \
    # Allow the desktop user to manage toolchains and Cargo-installed applications without sudo.
    && chown -R richard:richard /opt/rust \
    # Restore Rust's environment in login shells, including xrdp desktop sessions.
    && printf '%s\n' 'export CARGO_HOME=/opt/rust/cargo' 'export RUSTUP_HOME=/opt/rust/rustup' \
        'export PATH="/opt/rust/cargo/bin:$PATH"' > /etc/profile.d/rust.sh \
    # Check that the desktop account can use the compiler, package manager and language server.
    && sudo -u richard env CARGO_HOME="$CARGO_HOME" RUSTUP_HOME="$RUSTUP_HOME" PATH="$PATH" rustc --version \
    && sudo -u richard env CARGO_HOME="$CARGO_HOME" RUSTUP_HOME="$RUSTUP_HOME" PATH="$PATH" cargo --version \
    && sudo -u richard env CARGO_HOME="$CARGO_HOME" RUSTUP_HOME="$RUSTUP_HOME" PATH="$PATH" rust-analyzer --version \
    # Remove the installer after the toolchain is installed.
    && rm /tmp/rustup-init.sh

# Install development commands as the desktop user so Cargo's files remain writable without sudo.
USER richard
RUN \
    # Install the Rust standard library needed to compile Terrazzo's browser frontend.
    rustup target add wasm32-unknown-unknown \
    # Install the WebAssembly build tool before compiling Terrazzo Terminal.
    && cargo install --locked wasm-pack \
    # Install the SCSS bundler (the package provides the terrazzo-css executable).
    && cargo install --locked terrazzo-css-cli \
    # Install the published terminal server with production features and bundled browser assets.
    && cargo install --locked terrazzo-terminal --features prod \
    # Verify that all three installed commands are available on the image's PATH.
    && command -v wasm-pack terrazzo-css terrazzo-terminal

# Restore root for system configuration and the container's service entrypoint.
USER root

RUN \
    # Refresh indexes to install the tools needed to authenticate Mozilla's native APT repository.
    apt-get update \
    # Install the HTTPS downloader and OpenPGP key inspection tool without optional packages.
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends wget gpg \
    # Keep Mozilla's signing key separate from globally trusted APT keys.
    && install -d -m 755 /etc/apt/keyrings \
    # Download the repository key over HTTPS.
    && wget -qO /etc/apt/keyrings/packages.mozilla.org.asc https://packages.mozilla.org/apt/repo-signing-key.gpg \
    # Verify the key against the fingerprint published in Mozilla's Linux installation instructions.
    && test "$(gpg --batch --show-keys --with-colons /etc/apt/keyrings/packages.mozilla.org.asc \
        | awk -F: '$1 == "fpr" { print $10; exit }')" = '35BAA0B33E9EB396F59CA838C0BA5CE6DC6315A3' \
    # Add the official native-package repository using Ubuntu 26.04's deb822 source format.
    && printf '%s\n' 'Types: deb' 'URIs: https://packages.mozilla.org/apt' 'Suites: mozilla' \
        'Components: main' 'Signed-By: /etc/apt/keyrings/packages.mozilla.org.asc' \
        > /etc/apt/sources.list.d/mozilla.sources \
    # Prefer native Mozilla packages and prevent Ubuntu's Firefox-to-Snap transition package being selected.
    && printf '%s\n' 'Package: firefox*' 'Pin: origin packages.mozilla.org' 'Pin-Priority: 1001' '' \
        'Package: firefox' 'Pin: release o=Ubuntu' 'Pin-Priority: -1' > /etc/apt/preferences.d/mozilla \
    # Load the authenticated Mozilla package index, including ARM64 packages.
    && apt-get update \
    # Install Firefox directly; it does not require Snap or a systemd daemon.
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends firefox \
    # Make Firefox the system browser used by desktop launchers.
    && update-alternatives --set x-www-browser /usr/bin/firefox \
    # Remove package indexes and temporary GPG state from the resulting image layer.
    && rm -rf /var/lib/apt/lists/* /root/.gnupg

RUN \
    # Remove build-time machine IDs and snakeoil TLS files so each container generates its own identity.
    rm -f /etc/machine-id /var/lib/dbus/machine-id \
        /etc/ssl/private/ssl-cert-snakeoil.key /etc/ssl/certs/ssl-cert-snakeoil.pem \
    # Make D-Bus use the machine ID that the entrypoint generates at container startup.
    && ln -s /etc/machine-id /var/lib/dbus/machine-id

# Include the script that configures credentials and starts the required desktop services.
COPY entrypoint.sh /usr/local/bin/xrdp-container
RUN \
    # Make the copied startup script executable.
    chmod 755 /usr/local/bin/xrdp-container

# Tell the entrypoint where to read the login password; supply this file using a runtime Podman secret.
ENV RDP_PASSWORD_FILE=/run/secrets/rdp-password

# Document the container's RDP port; publishing it still requires an explicit Podman -p option.
EXPOSE 3389

# Check that the RDP listener accepts TCP connections; this does not verify a complete desktop login.
# Build with --format docker so Podman preserves this health-check metadata.
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD bash -c 'exec 3<>/dev/tcp/127.0.0.1/3389'

# Run tini as PID 1 to forward shutdown signals and reap orphaned processes, then invoke the service launcher.
ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/xrdp-container"]
